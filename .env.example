# Скопируйте в .env и заполните. Файл .env в git не попадает.

FLASK_ENV=development
SECRET_KEY=замените-на-длинную-случайную-строку
ADMIN_USERNAME=admin
ADMIN_PASSWORD=замените-пароль

# 0 — методички доступны только в онлайн-читалке; 1 — показать загрузку DOCX.
LIBRARY_DOWNLOADS_ENABLED=0

# Публичный адрес сайта (canonical, Open Graph, sitemap)
SITE_URL=https://st8dom.ru

# SQLite по умолчанию: instance/site.db
# DATABASE_URL=sqlite:///C:/path/to/instance/site.db

# Опционально: копия заявки в личный Telegram.
# Создайте бота у @BotFather и узнайте chat_id (например, @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email для получения заявок. Для Gmail используйте пароль приложения,
# обычный пароль аккаунта в репозиторий не добавляйте.
INQUIRY_EMAIL=dimitry8st@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1

# Опционально: идентификатор аналитики. Пока пусто — события только в dataLayer.
ANALYTICS_ID=

# Общий секрет сайта и n8n для синхронизации клинических рекомендаций.
# Сгенерируйте отдельную длинную случайную строку.
GUIDELINES_SYNC_TOKEN=

# Виджет FAQ на сайте. Без ключа отвечает из data/faqs.json.
CHAT_ENABLED=1
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
